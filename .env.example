# Voice Assistant Configuration

# General Configuration
DATABASE_URL=sqlite:///./voice_assistant.db
DATABASE_POOL_SIZE=5

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=1800
REDIS_MAX_CONNECTIONS=20

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=voice_assistant_exchange
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_RECONNECT_DELAY=5.0
RABBITMQ_MAX_RECONNECT=10

# Service URLs
ASR_SERVICE_URL=localhost:50051
NLU_SERVICE_URL=localhost:50052
DIALOG_SERVICE_URL=localhost:50053
TTS_SERVICE_URL=localhost:50054
STORAGE_SERVICE_URL=localhost:50055
NOTIFICATION_SERVICE_URL=localhost:50056

# Service Ports
ASR_SERVICE_PORT=50051
NLU_SERVICE_PORT=50052
DIALOG_SERVICE_PORT=50053
TTS_SERVICE_PORT=50054
STORAGE_SERVICE_PORT=50055
NOTIFICATION_SERVICE_PORT=50056
GATEWAY_SERVICE_PORT=8000

# Additional Service Ports (for Docker)
ASR_PORT=8001
NLU_PORT=8002
TTS_PORT=8003
DIALOG_PORT=8004
STORAGE_PORT=8005
NOTIFICATION_PORT=8006
GATEWAY_PORT=8000

# Host Ports (for Docker)
ASR_HOST_PORT=8001
NLU_HOST_PORT=8002
TTS_HOST_PORT=8003
DIALOG_HOST_PORT=8004
STORAGE_HOST_PORT=8005
NOTIFICATION_HOST_PORT=8006
GATEWAY_HOST_PORT=8000

# Plugin Configuration
PLUGINS_DIR=src/plugins

# ASR Plugin Configuration
VOSK_MODEL_PATH=/models/vosk-model-ru-0.42
ASR_SAMPLE_RATE=8000
VOSK_SAMPLE_RATE=8000
VOSK_PARTIAL_RESULTS=true

# NLU Plugin Configuration
NLU_LANGUAGE=ru
NLU_CASE_SENSITIVE=false
NLU_REGEX_ENABLED=true
NLU_SKLEARN_ENABLED=true
NLU_SKLEARN_TRAIN_ON_INIT=true
NLU_SKLEARN_MODEL_PATH=

# TTS Plugin Configuration
TTS_SILERO_MODEL_ID=v3_ru.pt
TTS_SILERO_SAMPLE_RATE=48000
TTS_SILERO_SPEAKER=baya
TTS_SILERO_DEVICE=cpu
TTS_MOCK_ENABLED=true
TTS_MOCK_DELAY_MS=0

# Storage Plugin Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voice_assistant
DB_USER=postgres
DB_PASSWORD=
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20
DB_COMMAND_TIMEOUT=60

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20

# Messaging Plugin Configuration
MESSAGING_RABBITMQ_ENABLED=true

# Notification Service Configuration
NOTIFICATION_QUEUE_NAME=notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMEOUT=30.0
TELEGRAM_MAX_RETRIES=5
TELEGRAM_RETRY_DELAY=1.0
TELEGRAM_MAX_RETRY_DELAY=60.0

# FreeSWITCH Configuration
FREESWITCH_HOST=localhost
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon

# Application Settings
SESSION_TIMEOUT_MINUTES=30
MAX_RETRY_ATTEMPTS=3

# Audio Processing Settings
AUDIO_CHUNK_DURATION_MS=200
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1

# Performance Settings
MAX_CONCURRENT_SESSIONS=100
GRPC_MAX_MESSAGE_LENGTH=4194304

# ASR Service Settings
PRIMARY_ASR_FAILURE_THRESHOLD=3
PRIMARY_ASR_TIMEOUT=30
FALLBACK_ASR_FAILURE_THRESHOLD=3
FALLBACK_ASR_TIMEOUT=30
ASR_CONFIDENCE_THRESHOLD=0.7

# Default Plugins
DEFAULT_ASR_PLUGIN=asr.vosk
DEFAULT_NLU_PLUGIN=nlu.regex
DEFAULT_TTS_PLUGIN=tts.silero