# Image Versions
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16.5

REDIS_IMAGE=redis
REDIS_VERSION=7.2.5

RABBITMQ_IMAGE=rabbitmq
RABBITMQ_VERSION=3.13.5-management

PROMETHEUS_IMAGE=prom/prometheus
PROMETHEUS_VERSION=v2.52.0

GRAFANA_IMAGE=grafana/grafana-enterprise
GRAFANA_VERSION=11.4.0

# Network Configuration
NETWORK_NAME=voiceassistant_default

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=voice_assistant
INIT_DB_SCRIPT=./infrastructure/init-db.sql

# Redis Configuration
REDIS_HOST=redis
REDIS_CONTAINER_PORT=6379
REDIS_HOST_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_CONTAINER_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Prometheus Configuration
PROMETHEUS_CONTAINER_PORT=9090
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_CONFIG_FILE=./infrastructure/prometheus.yml

# Grafana Configuration
GRAFANA_CONTAINER_PORT=3000
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Healthcheck Configuration
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3